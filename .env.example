# ---- Database ----
# Local Docker (see docker-compose.yml):
DATABASE_URL=postgres://utbsa:utbsa_dev_password@localhost:5432/utbsa

# ---- Session signing ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_64_character_hex_string

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email ----
# Leave MAIL_TRANSPORT=console in development: magic links print to the terminal
# instead of being emailed. Switch to smtp when you have a provider.
MAIL_TRANSPORT=console
MAIL_FROM="UTBSA <noreply@utoledobsa.org>"

# ── staging only ──────────────────────────────────────────────
# Every email goes to this address instead of the real recipient, whoever it
# was addressed to. Without it, testing the dues reminder on staging sends a
# hundred real members a real email.
#
# NEVER set this in production.
# MAIL_REDIRECT_TO=you@example.com

# Shows a banner on every page and blocks search engines, so nobody mistakes
# staging for the real site.
# STAGING=true
SMTP_HOST=
SMTP_PORT=2587   # NOT 587 — DigitalOcean blocks it
SMTP_USER=
SMTP_PASS=
